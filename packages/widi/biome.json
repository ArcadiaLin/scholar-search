{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"formatter": { "enabled": true, "indentStyle": "tab", "indentWidth": 2, "lineWidth": 120, "expand": "never" },
	"linter": { "enabled": true, "rules": { "recommended": true } },
	"overrides": [
		{
			"includes": ["packages/agent/**"],
			"formatter": { "indentStyle": "tab", "indentWidth": 3, "lineWidth": 120, "expand": "auto" },
			"linter": {
				"rules": {
					"recommended": true,
					"style": { "noNonNullAssertion": "off", "useConst": "error", "useNodejsImportProtocol": "off" },
					"suspicious": { "noExplicitAny": "off", "noControlCharactersInRegex": "off", "noEmptyInterface": "off" }
				}
			}
		}
	]
}
