# Build output and caches
node_modules/
dist/
packages/*/dist/
apps/*/dist/
coverage/
*.tsbuildinfo
*.cpuprofile
*.log
.npm/

# Upstream repositories cloned for reading only. `reference/pi` is the pi
# checkout: pull it freely, check out any tag, it is never built or resolved
# from. See docs/pi-fork.md.
reference/
# Left over from the era when pi was a submodule at this path.
/pi/

# Scratch space. Working notes, drafts, and throwaway analysis go in notes/;
# anything worth keeping is promoted into docs/ or apps/widi/docs/.
notes/
chat_notes/

# Environment
.env

# Editor and OS
.vscode/
.zed/
.idea/
.DS_Store
*.swp
*.swo
*~

# Agent tooling
.claude
.codex
.agents/
.superpowers/
docs/superpowers/
.pi-subagents

# Repo-local WIDI configuration is part of this imported source snapshot.
# Ignore only credentials and state created while running it.
.widi/auth.json
.widi/trust.json
.widi/runs/
