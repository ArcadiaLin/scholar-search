# Local reference material. Track source metadata, not binaries or full clones.
/packages/metascientist/
/papers/
/references/papers/
/references/repos/
/references/datasets/

# External data, model weights, and caches. Keep manifests and small fixtures tracked.
/data/raw/
/data/processed/
/data/cache/
/models/
/checkpoints/
/cache/

# Generated experiment output. Keep experiment code and configs under experiments/ tracked.
/runs/
/results/

# WIDI runtime state. Distribution configs under widis/.widi-* stay tracked.
/widis/.widi-*/auth.json
/widis/.widi-*/trust.json
/widis/.widi-*/runs/
/widis/.widi-*/*.lock

# Node.js dependencies, build output, and profiling artifacts.
node_modules/
dist/
coverage/
.npm/
*.tsbuildinfo
*.cpuprofile
/outputs/
/artifacts/
/experiments/**/runs/
/experiments/**/results/
/experiments/**/outputs/
/experiments/**/artifacts/
/wandb/
/mlruns/
/scratch/

# Secrets and machine-local configuration.
.env
.env.*
!.env.example

# Python environments, bytecode, test, type-checker, and build caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Editors and operating-system noise.
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temporary files.
*.log
*.tmp
*.swp
*~

notes/